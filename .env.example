# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Comma-separated Telegram User IDs allowed to use this bot (send /id to @userinfobot to find yours)
ALLOWED_TELEGRAM_USER_IDS=123456789

# Google Gemini AI Settings
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Google Sheets Configuration
# The ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_google_spreadsheet_id
SHEET_NAME=Transactions

# Google Service Account Credentials
# Option 1 (Local): Path to credentials.json file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Option 2 (Cloud / Render): Entire credentials JSON content as a single line string
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
